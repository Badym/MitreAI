# Porty wystawione tylko na localhost
FRONTEND_PORT=8080
BACKEND_PORT=8000
MONGO_PORT=27017

# Backend
MONGO_DB=mitreai

# Klucz do podpisywania tokenów, co najmniej 32 znaki. Wygeneruj: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Pierwsze konto administratora. Powstaje przy starcie, jeśli w bazie nie ma żadnego admina.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Modele do wyboru w czacie (lista JSON). Pierwszy jest domyślny. Na razie odpowiada atrapa.
AVAILABLE_MODELS=["mock-small","mock-large"]
